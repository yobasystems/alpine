# Alpine ${repo#*/} Environment Variables
# Copy this file to .env and update the values

# Note:
# This image does not require specific environment variables for basic usage.
# Environment variables can be passed directly to docker run or docker-compose.

# Example:
# docker run -e MY_VAR=value yobasystems/${repo#*/}

# For docker-compose, add under environment section:
# environment:
#   - MY_VAR=value
